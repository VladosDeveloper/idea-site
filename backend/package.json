{
  "name": "@idea-site/backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --watch ./src/emails/dist,./.env --rs --exit-child ./src/index.ts",
    "build-emails": "node src/emails/scripts/build-emails.ts",
    "watch-emails": "node src/emails/scripts/watch-emails.ts",
    "generate:trpc": "ts-node ./src/scripts/generate-trpc-routes.ts && eslint src/router/index.ts --fix",
    "build": "rimraf ./dist && tsc --build ./tsconfig.json",
    "pmd": "prisma migrate dev",
    "pgc": "prisma generate",
    "lint": "eslint .",
    "lint-fix": "eslint --fix",
    "types": "tsc --noEmit --project ./tsconfig.json",
    "start": "node ./dist/index.js",
    "prettify": "prettier --log-level warn --cache --write \"{src/**/*,*}.{ts,tsx,js,json,yml,scss}\" \"!**/{node_modules,dist}/**/*\"",
    "prepare": "pnpm pgc"
  },
  "prisma": {
    "schema": "./src/prisma/schema.prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.19.0",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/html-minifier": "^4.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.21",
    "@types/mjml": "^5.0.0",
    "@types/node": "^25.0.3",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1"
  },
  "dependencies": {
    "@prisma/client": "5.2.0",
    "@trpc/server": "^11.8.1",
    "chokidar": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.0",
    "html-minifier": "^4.0.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "mjml": "^5.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "5.2.0",
    "zod": "3.22.3"
  }
}
